# Copy to server/.env (docker-compose.yml requires this file to exist).

# "auto" (default): use the SageMath classifier service if reachable, else the built-in one
# "sage": only the SageMath service at CLASSIFIER_URL  |  "builtin": never call Sage
CLASSIFIER_MODE=auto
CLASSIFIER_URL=http://localhost:5001/api/classify

# MongoDB is optional; completed games are saved when it is reachable.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=knotlink
MONGODB_TIMEOUT_MS=2000
